# Code-Stil für Kotlin (ktlint über Spotless: ./gradlew spotlessApply / spotlessCheck).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
ktlint_code_style = android_studio
# Lange Zeilen sind in diesem Projekt üblich (deutsche Kommentare); harte Grenze gegen Ausreißer.
max_line_length = 160
# Compose-Funktionen beginnen mit Großbuchstaben.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Platzhalter-Importe sind verboten, Sternchen-Importe gibt es im Projekt nicht.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
